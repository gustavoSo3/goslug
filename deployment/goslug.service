[Unit]
Description=Goslug Go HTTP Server
After=network.target

[Service]
Type=simple
User={user}
WorkingDirectory=/home/{user}/goslug
ExecStart=/home/{user}/goslug/bin/main
Restart=always
RestartSec=5s
#Environment="PORT=:8080" "USERNAME=admin" "PASSWORD=password" "STORAGE_DRIVER=json"

[Install]
WantedBy=multi-user.target
